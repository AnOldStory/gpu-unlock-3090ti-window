@@ -1,5 +1,7 @@
 #include "probe_core.h"
 
+/* Offsets the unlocker actually gates on, plus the surrounding
+   fuse/WPR/engine state the author recorded on the reference card. */
 static const UINT32 Offsets[PROBE_SAMPLE_COUNT] = {
   0x000000, 0x118128, 0x118234, 0x110100, 0x1fa824, 0x1fa828,
   0x823804, 0x82381c, 0x823820, 0x1183a4, 0x625f04, 0x1fa7c8,
@@ -7,8 +9,32 @@
 };
 
 BOOLEAN ProbeMatches(const UINT32 *Config) {
-  return Config != NULL && Config[0] == 0x220610de &&
-         Config[11] == 0x38901462 && (Config[2] >> 24) == 3;
+  return Config != NULL && (Config[0] & 0xffffU) == 0x10deU &&
+         (Config[0] >> 16) == GU_PROFILE_PCI_DEVICE &&
+         (Config[2] >> 24) == 3U;
+}
+
+UINT32 ProbeProfileMismatches(const UINT32 *Config) {
+  UINT32 Mismatch = 0;
+  if (Config == NULL) return 0xffffffffU;
+  if (Config[0x2c / 4] != GU_BOARD_SUBSYSTEM) Mismatch |= PROBE_MISMATCH_SUBSYSTEM;
+  if ((Config[2] & 0xffU) != GU_BOARD_REVISION) Mismatch |= PROBE_MISMATCH_REVISION;
+  if ((Config[2] >> 24) != 3U) Mismatch |= PROBE_MISMATCH_CLASS;
+  return Mismatch;
+}
+
+BOOLEAN ProbeSample(const PROBE_RESULT *Result, UINT32 Offset, UINT32 *Value) {
+  UINTN I;
+  if (Result == NULL) return FALSE;
+  for (I = 0; I < PROBE_SAMPLE_COUNT; I++) {
+    if (Result->Samples[I].Offset == Offset) {
+      if (EFI_ERROR(Result->Samples[I].Status) || Result->Samples[I].Value == 0xffffffffU)
+        return FALSE;
+      if (Value != NULL) *Value = Result->Samples[I].Value;
+      return TRUE;
+    }
+  }
+  return FALSE;
 }
 
 EFI_STATUS ProbeCollect(EFI_PCI_IO_PROTOCOL *Pci, EFI_BOOT_SERVICES *Bs,
