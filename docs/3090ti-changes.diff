+/* A PCIe root port node. Unlike the endpoint node, an AMD root port can live on
+   function 1 (this machine: 00:03.1), so only the device number is matched. The
+   endpoint node below still has to be a function-0 device. */
+static BOOLEAN TakePciPort(const UINT8 **Bytes, UINTN *Remaining, UINT8 Device) {
+  const UINT8 *Node = *Bytes;
+  if (NodeLength(Node, *Remaining) != sizeof(PCI_DEVICE_PATH) ||
+      Node[0] != HARDWARE_DEVICE_PATH || Node[1] != HW_PCI_DP ||
+      Node[5] != Device)
+    return FALSE;
+  *Bytes += sizeof(PCI_DEVICE_PATH);
+  *Remaining -= sizeof(PCI_DEVICE_PATH);
+  return TRUE;
+}
